# --- K8ston local development -------------------------------------------
# The app talks to Kubernetes via ~/.kube/config when not running in-cluster.

# Public URL (used for OIDC redirect: <APP_URL>/api/auth/callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scope: namespace (default) reads POD_NAMESPACE only; cluster lists all namespaces
K8STON_SCOPE=namespace
K8STON_NAMESPACE=default
K8STON_NAMESPACES=
# Eligible snapshots per live UID: integer 1–100 (unset defaults to 20).
# Zero/negative/malformed values fail; legacy/unbound history needs operator cleanup.
K8STON_HISTORY_LIMIT=20
# Hide secrets not created by K8ston (missing k8ston.io/managed-by=k8ston):
# excluded from lists, 404 on direct access. Prevents accidental edits of
# K8s-level secrets. Set false to show everything (legacy adopt-on-edit flow).
K8STON_MANAGED_ONLY=true

# Set true once the cluster has etcd encryption-at-rest (aescbc) enabled,
# otherwise the UI shows a warning banner (secrets are only base64 in etcd).
K8STON_ETCD_ENCRYPTED=false

# K8s API impersonation (requires the API server to trust the same OIDC issuer).
# false = hybrid mode: app ServiceAccount executes, K8ston enforces authz itself.
K8STON_IMPERSONATION=false

# "Restart apps" feature (rolling restart of workloads consuming a secret).
# Default false: UI button + hint hidden, API returns 403, and the
# ServiceAccount needs no `apps` permissions. Set true to enable (also keep
# the deployments/statefulsets/daemonsets rule in the Role/ClusterRole).
K8STON_RESTART_ENABLED=false

# Bootstrap admins (SSO groups / emails). When BOTH are empty, every
# authenticated user is admin until you configure them.
K8STON_ADMIN_GROUPS=k8ston-admin
K8STON_ADMIN_USERS=
K8STON_ANNOTATION_PREFIX=k8ston.io
K8STON_ACCESS_CONFIGMAP=k8ston-access

# --- Auth --------------------------------------------------------------------
# AUTH_DISABLED=true skips SSO with a mock admin (local dev only!)
AUTH_DISABLED=true
# Required before enabling auth: a fresh random key of at least 32 characters.
# Generate with: openssl rand -hex 32. No default; the former dev key is rejected.
# Builds and explicit AUTH_DISABLED=true do not need a signing key.
SESSION_SECRET=

# Generic OIDC SSO (Keycloak / Entra ID / Okta / Google / GitHub)
# OIDC_ISSUER is the issuer identifier, NOT the discovery URL: the app appends
# /.well-known/openid-configuration itself. It must exactly match the "issuer"
# field of that document (Keycloak realms often live under /auth/realms/...).
OIDC_ISSUER=https://keycloak.example.com/realms/company
OIDC_CLIENT_ID=k8ston
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Allow http:// issuers (sandbox Dex on loopback). Refused for non-loopback
# issuers and when NODE_ENV=production.
OIDC_ALLOW_HTTP=false
OIDC_SCOPES=openid profile email groups
# First nonempty string-array claim wins: configured path, groups, roles,
# then nested realm_access.roles (Keycloak). Dotted configured paths are supported.
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=email
OIDC_NAME_CLAIM=name
SESSION_MAX_AGE=28800
