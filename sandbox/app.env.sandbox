# K8ston app env for sandbox mode — copy to app/.env:
#   cp sandbox/app.env.sandbox app/.env
# Requires `make up` (kind + Dex + fixtures). All values are sandbox-only.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cluster scope over the two fixture namespaces (see kind/fixtures).
K8STON_SCOPE=cluster
K8STON_NAMESPACE=k8ston-test
K8STON_NAMESPACES=k8ston-test,frontend-ns
K8STON_HISTORY_LIMIT=20
# false here so the sandbox still demonstrates the unmanaged legacy-external
# fixture (badge + adopt-on-edit); production default is true (hidden).
K8STON_MANAGED_ONLY=false
K8STON_ETCD_ENCRYPTED=false
K8STON_IMPERSONATION=false
# true here so the sandbox demonstrates the restart flow (consumer fixture);
# the default is false (feature hidden).
K8STON_RESTART_ENABLED=true
K8STON_ADMIN_GROUPS=k8ston-admin
K8STON_ADMIN_USERS=
K8STON_ANNOTATION_PREFIX=k8ston.io
K8STON_ACCESS_CONFIGMAP=k8ston-access

# Real SSO against sandbox Dex (users: alice/bob/carol/admin, password `password`).
AUTH_DISABLED=false
SESSION_SECRET="sandbox-only-session-secret-32chars!!!"
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=k8ston
OIDC_CLIENT_SECRET="k8ston-sandbox-secret"
OIDC_ALLOW_HTTP=true
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=email
OIDC_NAME_CLAIM=name
SESSION_MAX_AGE=28800
